---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, pick } from '../i18n/ui.ts';
import { HREFLANG, type Lang } from '../i18n/index.ts';
import { getFaq } from '../i18n/faq.ts';
import { TOOLS } from '../tools.ts';
import { localePath, toolUrl } from '../lib/url.ts';
import { postsByLang, readingMinutes, postSlug } from '../lib/blog.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const title =
  lang === 'zh-cn'
    ? '把 Markdown 转成 Word、PDF、HTML 等格式 - MD Toolkit'
    : 'Convert Markdown to Word, PDF, HTML & More | MD Toolkit';
const description = t(lang, 'home.subtitle');

const site = (Astro.site ?? new URL('https://mdtoolkit.dev')).href.replace(/\/$/, '');
const homeUrl = `${site}${localePath('/', lang)}`;
const faq = getFaq(lang);

// 首页博客精选：给 blog 引流。当前首页原本 0 处指向 blog 的内部链接。
const latestPosts = (await postsByLang(lang)).slice(0, 3);
const fmtPost = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' });

// 首页结构化数据：站点身份 + 工具清单 + FAQ。
// ItemList 让搜索引擎把 18 个工具当成一组来理解；FAQPage 用来抢 People Also Ask 的位置。
// 注意别和工具页的 FAQ 撞车 —— 工具页每页都问隐私/注册/手机/PDF，这里刻意问站点级问题。
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'MD Toolkit',
      url: homeUrl,
      description,
      inLanguage: HREFLANG[lang],
    },
    {
      '@type': 'Organization',
      name: 'MD Toolkit',
      url: site,
    },
    {
      '@type': 'ItemList',
      name: t(lang, 'nav.home'),
      numberOfItems: TOOLS.length,
      itemListElement: TOOLS.map((tool, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: pick(lang, tool.name),
        url: `${site}${toolUrl(tool.slug, lang)}`,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={jsonLd}>
  <div class="container">
    <section class="hero">
      <span class="hero__badge">{t(lang, 'home.badge')}</span>
      <h1>{t(lang, 'home.title')}</h1>
      <p>{t(lang, 'home.subtitle')}</p>
    </section>

    <div class="tool-grid">
      {
        TOOLS.map((tool) => (
          <a class="tool-card" href={toolUrl(tool.slug, lang)}>
            <div class="tool-card__name">{pick(lang, tool.name)}</div>
            <div class="tool-card__desc">{pick(lang, tool.intro).slice(0, 62)}…</div>
          </a>
        ))
      }
    </div>

    <section class="section">
      <h2>{t(lang, 'why.title')}</h2>
      <div class="feature-grid">
        <div class="feature">
          <h3>{t(lang, 'why.local')}</h3>
          <p>{t(lang, 'why.local.desc')}</p>
        </div>
        <div class="feature">
          <h3>{t(lang, 'why.open')}</h3>
          <p>{t(lang, 'why.open.desc')}</p>
        </div>
        <div class="feature">
          <h3>{t(lang, 'why.free')}</h3>
          <p>{t(lang, 'why.free.desc')}</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>{t(lang, 'steps.title')}</h2>
      <div class="steps">
        <div class="step">
          <div class="step__num">1</div>
          <h3>{t(lang, 'steps.1')}</h3>
          <p>{t(lang, 'steps.1.desc')}</p>
        </div>
        <div class="step">
          <div class="step__num">2</div>
          <h3>{t(lang, 'steps.2')}</h3>
          <p>{t(lang, 'steps.2.desc')}</p>
        </div>
        <div class="step">
          <div class="step__num">3</div>
          <h3>{t(lang, 'steps.3')}</h3>
          <p>{t(lang, 'steps.3.desc')}</p>
        </div>
      </div>
    </section>

    {
      latestPosts.length > 0 && (
        <section class="section">
          <div class="blog-head">
            <h2>{t(lang, 'home.blogTitle')}</h2>
            <a class="blog-all" href={localePath('/blog/', lang)}>{t(lang, 'blog.back')} →</a>
          </div>
          <div class="blog-grid">
            {
              latestPosts.map((post) => (
                <a class="blog-card" href={localePath(`/blog/${postSlug(post)}/`, lang)}>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <div class="blog-card__meta">
                    <time datetime={post.data.pubDate.toISOString()}>{fmtPost.format(post.data.pubDate)}</time>
                    <span>· {readingMinutes(post.body, lang)} min</span>
                  </div>
                </a>
              ))
            }
          </div>
        </section>
      )
    }

    <section class="section">
      <h2>{faq.title}</h2>
      <div class="faq">
        {
          faq.items.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
