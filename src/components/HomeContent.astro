---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, pick } from '../i18n/ui.ts';
import type { Lang } from '../i18n/index.ts';
import { TOOLS } from '../tools.ts';
import { toolUrl } from '../lib/url.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const title =
  lang === 'zh-cn'
    ? '把 Markdown 转成 Word、PDF、HTML 等格式 - MD Toolkit'
    : 'Convert Markdown to Word, PDF, HTML & More | MD Toolkit';
const description = t(lang, 'home.subtitle');
---

<BaseLayout lang={lang} title={title} description={description}>
  <div class="container">
    <section class="hero">
      <span class="hero__badge">{t(lang, 'home.badge')}</span>
      <h1>{t(lang, 'home.title')}</h1>
      <p>{t(lang, 'home.subtitle')}</p>
    </section>

    <div class="tool-grid">
      {
        TOOLS.map((tool) => (
          <a class="tool-card" href={toolUrl(tool.slug, lang)}>
            <div class="tool-card__name">{pick(lang, tool.name)}</div>
            <div class="tool-card__desc">{pick(lang, tool.intro).slice(0, 62)}…</div>
          </a>
        ))
      }
    </div>

    <section class="section">
      <h2>{t(lang, 'why.title')}</h2>
      <div class="feature-grid">
        <div class="feature">
          <h3>{t(lang, 'why.local')}</h3>
          <p>{t(lang, 'why.local.desc')}</p>
        </div>
        <div class="feature">
          <h3>{t(lang, 'why.open')}</h3>
          <p>{t(lang, 'why.open.desc')}</p>
        </div>
        <div class="feature">
          <h3>{t(lang, 'why.free')}</h3>
          <p>{t(lang, 'why.free.desc')}</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>{t(lang, 'steps.title')}</h2>
      <div class="steps">
        <div class="step">
          <div class="step__num">1</div>
          <h3>{t(lang, 'steps.1')}</h3>
          <p>{t(lang, 'steps.1.desc')}</p>
        </div>
        <div class="step">
          <div class="step__num">2</div>
          <h3>{t(lang, 'steps.2')}</h3>
          <p>{t(lang, 'steps.2.desc')}</p>
        </div>
        <div class="step">
          <div class="step__num">3</div>
          <h3>{t(lang, 'steps.3')}</h3>
          <p>{t(lang, 'steps.3.desc')}</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
