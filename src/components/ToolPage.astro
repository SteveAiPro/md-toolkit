---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitEditor from './SplitEditor.astro';
import { t, pick } from '../i18n/ui.ts';
import type { Lang } from '../i18n/index.ts';
import { localePath, toolUrl } from '../lib/url.ts';
import { breadcrumbList } from '../lib/schema.ts';
import { relatedTools } from '../lib/related.ts';
import type { ToolDef } from '../tools.ts';

interface Props {
  lang: Lang;
  tool: ToolDef;
}
const { lang, tool } = Astro.props;

const title = pick(lang, tool.seoTitle);
const description = pick(lang, tool.seoDesc);
const siteUrl = (Astro.site ?? 'https://example.com').href.replace(/\/$/, '');
const canonical = `${siteUrl}${toolUrl(tool.slug, lang)}`;

const faqs = [
  { q: t(lang, 'faq.privacy.q'), a: t(lang, 'faq.privacy.a') },
  { q: t(lang, 'faq.account.q'), a: t(lang, 'faq.account.a') },
  { q: t(lang, 'faq.mobile.q'), a: t(lang, 'faq.mobile.a') },
  { q: t(lang, 'faq.pdf.q'), a: t(lang, 'faq.pdf.a') },
];

const homeUrl = `${siteUrl}${localePath('/', lang)}`;

// 相关工具内链：工具页 <-> 工具页，让 18 个转换器形成语义网而不是孤岛
const related = relatedTools(tool);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbList([
      { name: t(lang, 'nav.home'), url: homeUrl },
      { name: pick(lang, tool.name), url: canonical },
    ]),
    {
      '@type': 'WebApplication',
      name: pick(lang, tool.name),
      url: canonical,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout lang={lang} title={title} description={description} slug={tool.slug} jsonLd={jsonLd}>
  <div class="container">
    <div class="tool-head">
      <h1>{pick(lang, tool.h1)}</h1>
      <p>{pick(lang, tool.intro)}</p>
    </div>

    <SplitEditor lang={lang} tool={tool} />

    <section class="section">
      <h2>{t(lang, 'faq.title')}</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2>{t(lang, 'tool.related')}</h2>
      <ul class="related">
        {
          related.map((r) => (
            <li>
              <a href={toolUrl(r.slug, lang)}>
                <span class="related__name">{pick(lang, r.name)}</span>
                <span class="related__desc">{pick(lang, r.seoDesc)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .tool-head { padding: 36px 0 4px; max-width: 760px; }
  .tool-head h1 { font-size: clamp(24px, 3.2vw, 34px); margin: 0 0 10px; font-weight: 600; letter-spacing: -0.02em; }
  .tool-head p { margin: 0; color: var(--text-soft); font-size: 15.5px; }

  .related { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .related a {
    display: grid;
    gap: 3px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    background: var(--bg-soft);
    height: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .related a:hover { border-color: var(--brand); transform: translateY(-1px); }
  .related__name { font-size: 14.5px; font-weight: 600; color: var(--text); }
  .related__desc { font-size: 12.8px; color: var(--text-soft); line-height: 1.45; }
</style>
