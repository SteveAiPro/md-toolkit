# ===== MD Toolkit 环境变量 =====
# 站点正式域名（canonical / hreflang / sitemap / RSS 都用它推导）
SITE_URL=https://mdtoolkit.dev

# ===== GA4 网站分析（可选）=====
# 留空则不加载任何分析脚本。在 Vercel 环境变量里设同名变量即可生效。
PUBLIC_GA4_ID=G-XXXXXXXXXX

# ===== Google AdSense 广告（可选，需先通过审核）=====
# 两者都填才会显示广告位；缺一则完全不渲染，不影响页面。
PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT=0000000000
